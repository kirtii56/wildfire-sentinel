# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
# Local PostgreSQL example: postgresql://wildfire:wildfire@localhost:5432/wildfire
# Supabase: use the connection string from Project Settings -> Database.
# v2 uses an ordinary Postgres role with INSERT/SELECT on the app tables.
# It does NOT use, and must not be given, a Supabase service-role key.
DATABASE_URL=postgresql://user:password@host:5432/wildfire

# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=your_map_key_here

# Ingest scope. REQUIRED — there is no default.
# 'world' or a bounding box 'lon_min,lat_min,lon_max,lat_max'.
# A world VIIRS query returns tens of thousands of rows per day and consumes a
# meaningful share of the FIRMS transaction quota, so choose this deliberately.
FIRMS_AREA=

# Comma-separated FIRMS product keys.
# Supported: VIIRS_NOAA20_NRT, VIIRS_SNPP_NRT, VIIRS_NOAA21_NRT
FIRMS_PRODUCTS=VIIRS_NOAA20_NRT,VIIRS_SNPP_NRT,VIIRS_NOAA21_NRT

# Days of data per run, 1-5 (FIRMS limit).
FIRMS_DAY_RANGE=1

LOG_LEVEL=INFO
